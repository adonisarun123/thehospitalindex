# Copy to .env.local. Never commit real values.

# Neon POOLED connection string (host contains "-pooler"). Used by the running app.
DATABASE_URL=

# Neon DIRECT connection string (no "-pooler"). Used only by `npm run db:migrate` and seeds.
DATABASE_URL_UNPOOLED=

# Canonical origin, no trailing slash. Drives canonicals, sitemaps and JSON-LD.
SITE_URL=https://thehospitalindex.com
